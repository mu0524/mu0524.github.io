{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@lib/*": ["./src/lib/*"],
			"@styles/*": ["./src/styles/*"]
		}
	},
	"include": [".astro/types.d.ts", "./src/**/*", "./scripts/**/*"],
	"exclude": ["dist"]
}
