---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import { DEFAULT_LANG } from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;

const currentLang = lang || siteConfig.lang.replace("_", "-") || DEFAULT_LANG;
---

<Layout
    title={title}
    banner={banner}
    description={description}
    lang={currentLang}
    setOGTypeArticle={setOGTypeArticle}
>

<slot slot="head" name="head"></slot>

<div id="page-wrap" class="pageWrap">
    <!-- Info 區（導覽） -->
    <div id="navbar-wrapper">
        <Navbar lang={currentLang} />
    </div>

    <!-- Main content -->
    <main id="swup-container" class="transition-swup-fade mainArea">
        <div id="content-wrapper" class="onload-animation">
            <slot></slot>
        </div>
    </main>

    <div class="footer onload-animation">
        <Footer></Footer>
    </div>

    <BackToTop></BackToTop>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-(--page-width) mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-(--toc-width) w-(--toc-width) items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-(--toc-width) h-[calc(100vh-20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>

<style lang="scss">
.pageWrap {
    position: relative;
    max-width: calc(var(--page-width) + 32px);
    margin: 0 auto;
    padding: 45px 16px 0;
}

.mainArea {
    margin-top: 64px;
}

@media (max-width: 768px) {
    .pageWrap {
        padding-top: 16px;
    }

    .mainArea {
        margin-top: 32px;
    }
}
</style>
