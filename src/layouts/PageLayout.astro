---
import BackToTop from "@components/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import type { SeoProps } from "@components/Seo.astro";
import BaseLayout from "./BaseLayout.astro";

type Props = SeoProps;
---

<BaseLayout {...Astro.props}>
	<slot name="head" slot="head" />

	<div class="pageWrap">
		<Header />

		<!-- 換頁時只替換這一塊；目錄放在動畫外層，避免 translate 影響 fixed 定位 -->
		<main id="swup-container" class="mainArea transition-swup-fade">
			<div class="onloadAnimation">
				<slot />
			</div>
			<slot name="aside" />
		</main>

		<Footer />
	</div>

	<BackToTop />
</BaseLayout>

<script>
import "../scripts/main";
</script>

<style lang="scss">
@use '../styles/setting' as *;

.pageWrap {
	position: relative;
	max-width: calc(var(--page-width) + 2rem);
	margin: 0 auto;
	padding: 2.8125rem 1rem 0;

	@include media($breakpointSmall) {
		padding-top: 1rem;
	}
}

.mainArea {
	margin-top: 4rem;

	@include media($breakpointSmall) {
		margin-top: 2rem;
	}
}
</style>
