---
import { getImage } from "astro:assets";
import ogDefault from "@assets/images/theme/og-default.png";
import { formatIsoDate } from "@lib/date";
import type { ImageMetadata } from "astro";
import { SITE } from "@/site.config";

export interface SeoProps {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	article?: {
		published: Date;
		updated?: Date;
		tags: string[];
	};
}

const { title, description, image, article } = Astro.props as SeoProps;

const fullTitle = title
	? `${title} - ${SITE.title}`
	: `${SITE.title} - ${SITE.subtitle}`;
const desc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 沒有封面的頁面（首頁、彙整、關於我等）用全站預設分享圖
const ogImage = new URL(
	// 封面是透明背景 PNG，轉 JPEG 前先鋪白底，否則透明處會變黑
	(
		await getImage({
			src: image ?? ogDefault,
			width: 1200,
			format: "jpeg",
			background: "#ffffff",
		})
	).src,
	Astro.site,
).href;
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.lang.replace("-", "_")} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:image" content={ogImage} />

{article && (
	<>
		<meta property="article:published_time" content={formatIsoDate(article.published)} />
		{article.updated && <meta property="article:modified_time" content={formatIsoDate(article.updated)} />}
		{article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
	</>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
