---
import { getImage } from "astro:assets";
import { formatIsoDate } from "@lib/date";
import type { ImageMetadata } from "astro";
import { SITE } from "@/site.config";

export interface SeoProps {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	article?: {
		published: Date;
		updated?: Date;
		tags: string[];
	};
}

const { title, description, image, article } = Astro.props as SeoProps;

const fullTitle = title
	? `${title} - ${SITE.title}`
	: `${SITE.title} - ${SITE.subtitle}`;
const desc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = image
	? new URL(
			(await getImage({ src: image, width: 1200, format: "jpeg" })).src,
			Astro.site,
		).href
	: undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.lang.replace("-", "_")} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={article ? "article" : "website"} />
{ogImage && <meta property="og:image" content={ogImage} />}

{article && (
	<>
		<meta property="article:published_time" content={formatIsoDate(article.published)} />
		{article.updated && <meta property="article:modified_time" content={formatIsoDate(article.updated)} />}
		{article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
	</>
)}

<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
