---
import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import { formatDateToYYYYMMMD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	subcategory?: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	lang?: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	subcategory,
	image,
	description,
	style,
	lang,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await render(entry);
---
<article class:list={["postItem", className]} style={style}>
    <div class="item">
        <div class="metaBox">
            <span class="tag">{formatDateToYYYYMMMD(published)}</span>
            {category && (
                <a href={getCategoryUrl(category, lang)} class="tag">
                    {category}{subcategory && ` / ${subcategory}`}
                </a>
            )}
        </div>

        <div class="titleBox">
            <h2 class="title">{title}</h2>
        </div>

        <div class="contentBox">
            {hasCover && (
                <figure class="Img">
                    <ImageWrapper src={image} basePath={path.join("content/posts/", entry.id)} alt={title} class="w-full h-full" />
                </figure>
            )}

            <p class="text">{description || remarkPluginFrontmatter.excerpt}</p>

            {tags.length > 0 && (
                <div class="tagBox">
                    {tags.map((tag) => (
                        <a href={getTagUrl(tag, lang)}># {tag}</a>
                    ))}
                </div>
            )}
        </div>

        <a href={url} class="linkWrap" aria-label={title}></a>
    </div>
</article>

<style lang="scss">
@import '../styles/setting';

.postItem {
	position: relative;
	min-width: 0;
}

.item {
	position: relative;
	@include flex();
	flex-direction: column;
	gap: 1.25em;
	height: 100%;
	@include font($ls: .08em, $lh: 1.8);
	background-color: $grayColor;
	padding: 2.25em 1.25em 1.5em;

	@include media(1366) {
		font-size: $textSizeMedium;
	}
	@include media($breakpointSmall) {
		font-size: $textSizeSmall;
	}

	@include hover {
		.title {
			color: $mainColor;
		}

		.Img {
			:global(img) {
				scale: 1.05;
			}
		}
	}
}

.metaBox {
	@include positionALTRB($t: -1.25em, $l: 1.25em);
	z-index: 3;
	@include flex(wrap);
	gap: 1em;
	max-width: calc(100% - 2.5em);

	.tag {
		white-space: nowrap;
		color: $textColor;
		background-color: var(--surface-tag);
		padding: .375em 1em;
		@extend %ts;
	}

	a {
		@include hover {
			color: $mainColor;
		}
	}
}

.titleBox {
	@include flex(nowrap, center, center);
	gap: .625em;
	border-bottom: 2px dashed $borderColor;
	padding-bottom: .5em;

	@include pseudoBefore($position: relative) {
		@include pseudoShape(10px, 3px, $borderColor);
		flex-shrink: 0;
	}

	@include pseudoAfter($position: relative) {
		@include pseudoShape(10px, 3px, $borderColor);
		flex-shrink: 0;
	}

	.title {
		flex: 1 1 0;
		min-width: 0;
		font-size: 1.25em;
		font-weight: $fwRegular;
		line-height: 1.5;
		color: $textColor;
		text-align: center;
		@include ellipsis(2);
		@extend %ts;
	}
}

.contentBox {
	@include flex();
	flex-direction: column;
	flex: 1 1 auto;
	gap: 1em;

	.Img {
		aspect-ratio: 16 / 9;
		overflow: clip;

		:global(img) {
			will-change: scale;
			@extend %ts;
		}
	}

	.text {
		color: $introColor;
		@include ellipsis(3);
		min-height: 5.4em;
	}

	.tagBox {
		position: relative;
		z-index: 3;
		@include flex(wrap, flex-end);
		gap: .625em;
		margin-top: auto;

		a {
			color: $mainColor;
			@include textTrim();
			@extend %ts;

			@include hover {
				color: $textColor;
			}
		}
	}
}

.linkWrap {
	@include cover;
	z-index: 2;
}
</style>
