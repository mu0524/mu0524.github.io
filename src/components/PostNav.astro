---
import iconPrev from "@assets/images/theme/icon-angle-double-left.svg?url";
import iconNext from "@assets/images/theme/icon-angle-double-right.svg?url";

// 文章頁與 Lab 內頁共用：unit 是「篇」「個」這類量詞，用在無障礙標籤
interface NavItem {
	title: string;
	url: string;
}

interface Props {
	newer?: NavItem;
	older?: NavItem;
	unit?: string;
	label?: string;
}

const { newer, older, unit = "篇", label = "上下篇文章" } = Astro.props;
---

{(newer || older) && (
	<nav class="pageNavBox" aria-label={label}>
		{newer ? (
			<a href={newer.url} class="btn prev" aria-label={`上一${unit}：${newer.title}`}>
				<img src={iconPrev} alt="" width="16" height="16" />
				<span>{newer.title}</span>
			</a>
		) : <span></span>}
		{older && (
			<a href={older.url} class="btn next" aria-label={`下一${unit}：${older.title}`}>
				<span>{older.title}</span>
				<img src={iconNext} alt="" width="16" height="16" />
			</a>
		)}
	</nav>
)}

<style lang="scss">
@use '../styles/setting' as *;

.pageNavBox {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 1.5rem;
	margin-top: 1.5rem;

	@include media($breakpointSmall) {
		grid-template-columns: minmax(0, 1fr);
		gap: .75rem;
	}

	.btn {
		@include flex(nowrap, flex-start, center);
		gap: .75rem;
		min-width: 0;
		height: 3.5rem;
		@include font($ls: .08em, $lh: 1.5);
		background-color: $grayColor;
		padding: 0 1.25rem;
		@extend %ts;

		@include hover {
			color: $mainColor;
			background-color: $borderColor;
		}

		&.next {
			grid-column: 2 / 3;
			justify-content: flex-end;

			@include media($breakpointSmall) {
				grid-column: auto;
			}
		}

		span {
			@include oneLine;
		}

		img {
			flex-shrink: 0;
			width: 16px;
			height: 16px;
		}
	}
}
</style>
