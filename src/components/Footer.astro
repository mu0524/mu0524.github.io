---
import bunnyWalking from "@assets/images/theme/bunny-walking.gif";
import { DAY_MS, formatIsoDate, formatTaipeiDate } from "@lib/date";
import { getLastPushTime } from "@lib/last-push";
import { getCategoryTree, getPosts, getSiteStats, getTags } from "@lib/posts";
import { withBase } from "@lib/url";
import { SITE } from "@/site.config";

const posts = await getPosts();
const categories = getCategoryTree(posts);
const tags = getTags(posts);
const stats = await getSiteStats(posts);

const currentYear = new Date().getFullYear();
const startTime = stats.firstPublished?.getTime() ?? Date.now();
const runningDays = Math.floor((Date.now() - startTime) / DAY_MS) + 1;
// 最後活動：最後一次 push 的時間；抓不到時改用文章最新的發布、更新日期
const lastPush = getLastPushTime();
const lastActivity = lastPush
	? formatTaipeiDate(lastPush).replaceAll("-", "/")
	: stats.lastActivity
		? formatIsoDate(stats.lastActivity).replaceAll("-", "/")
		: "-";
---

<footer class="footerArea">
	<div class="otherBox">
		<div class="Img" aria-hidden="true">
			<!-- GIF 動畫不經過 Astro 圖片轉檔（會變成靜態圖），直接輸出原檔 -->
			<img src={bunnyWalking.src} alt="" width={bunnyWalking.width} height={bunnyWalking.height} loading="lazy" decoding="async" />
		</div>

		<div class="otherItem">
			<div class="titleBox">
				<p class="title">分類</p>
			</div>
			<ul class="categoryList">
				{categories.map((c) => (
					<li class:list={["categoryItem", { close: c.children.length > 0 }]} data-category={c.name}>
						<div class="name">
							<a href={c.url}>
								<span>{c.name}</span>
								{c.children.length === 0 && <span class="count">({c.count})</span>}
							</a>
							{c.children.length > 0 && (
								<button class="toggle" type="button" aria-expanded="false" aria-label={`展開${c.name}`} data-name={c.name}></button>
							)}
						</div>
						{c.children.length > 0 && (
							<ul class="subList">
								{c.children.map((s) => (
									<li class="subItem" data-subcategory={s.name}>
										<a href={s.url}>
											<span>{s.name}</span>
											<span class="count">({s.count})</span>
										</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</div>

		<div class="otherItem">
			<div class="titleBox">
				<p class="title">標籤</p>
			</div>
			<div class="tagBox">
				<div class="tagList" id="footer-tag-list">
					{tags.map((t) => (
						<a href={t.url}>{t.name}</a>
					))}
				</div>
				<!-- 標籤超過三排才會由 JS 收合並顯示按鈕；沒有 JS 時維持全部展開 -->
				<button class="tagToggle" type="button" aria-expanded="false" aria-controls="footer-tag-list" hidden>
					<span>展開全部</span>
				</button>
			</div>
		</div>

		<div class="otherItem">
			<div class="titleBox">
				<p class="title">站點統計</p>
			</div>
			<dl class="statList">
				<div class="statItem">
					<dt>文章</dt>
					<dd>({stats.postCount})</dd>
				</div>
				<div class="statItem">
					<dt>分類</dt>
					<dd>({stats.categoryCount})</dd>
				</div>
				<div class="statItem">
					<dt>標籤</dt>
					<dd>({stats.tagCount})</dd>
				</div>
				<div class="statItem">
					<dt>總字數</dt>
					<dd>{stats.wordCount.toLocaleString("en-US")}</dd>
				</div>
				<div class="statItem full">
					<dt>運作天數</dt>
					<dd id="running-days" data-start={startTime}>{runningDays}天</dd>
				</div>
				<div class="statItem full">
					<dt>最後活動</dt>
					<dd>{lastActivity}</dd>
				</div>
			</dl>
		</div>
	</div>

	<p class="copyright">
		&copy; {currentYear} {SITE.author}. All Rights Reserved.{" / "}
		<a target="_blank" href={withBase("/rss.xml")}>RSS</a>{" / "}
		<a target="_blank" href={withBase("/sitemap-index.xml")}>Sitemap</a>{" / Powered by "}
		<a target="_blank" href="https://astro.build" rel="noopener">Astro</a>
	</p>
</footer>

<script>
import { DAY_MS } from "@lib/date";
import { onPageLoad } from "../scripts/page-load";

// 靜態頁面在 build 時算好天數，載入時再以當天日期更新，避免兩次 build 之間天數停住
function updateRunningDays() {
	const el = document.getElementById("running-days");
	const start = Number(el?.dataset.start);
	if (!el || !start) return;
	el.textContent = `${Math.floor((Date.now() - start) / DAY_MS) + 1}天`;
}

function setCategoryOpen(item: Element, isOpen: boolean) {
	const btn = item.querySelector<HTMLButtonElement>(".toggle");
	if (!btn) return;
	item.classList.toggle("close", !isOpen);
	btn.setAttribute("aria-expanded", String(isOpen));
	btn.setAttribute("aria-label", `${isOpen ? "收合" : "展開"}${btn.dataset.name ?? ""}`);
}

function bindCategoryToggle() {
	for (const btn of document.querySelectorAll<HTMLButtonElement>(".footerArea .toggle")) {
		btn.addEventListener("click", () => {
			const item = btn.closest(".categoryItem");
			if (item) setCategoryOpen(item, item.classList.contains("close"));
		});
	}
}

// 頁尾不在換頁替換範圍內，每次換頁都依目前文章展開所屬分類、標記 current
function syncCurrentCategory() {
	const post = document.getElementById("post-container");
	const category = post?.dataset.category;
	const subcategory = post?.dataset.subcategory;

	for (const item of document.querySelectorAll(".footerArea .categoryItem")) {
		const isCurrent = !!category && item.getAttribute("data-category") === category;
		item.classList.toggle("current", isCurrent);
		setCategoryOpen(item, isCurrent);

		for (const sub of item.querySelectorAll(".subItem")) {
			sub.classList.toggle(
				"current",
				isCurrent && !!subcategory && sub.getAttribute("data-subcategory") === subcategory,
			);
		}
	}
}

// 標籤超過三排時收合，按鈕切換展開／收合
function setTagOpen(box: Element, isOpen: boolean) {
	const btn = box.querySelector<HTMLButtonElement>(".tagToggle");
	if (!btn) return;
	box.classList.toggle("close", !isOpen);
	btn.setAttribute("aria-expanded", String(isOpen));
	btn.querySelector("span")!.textContent = isOpen ? "收合" : "展開全部";
}

// 先套上收合狀態再量高度，內容沒有超出就不需要按鈕
function checkTagOverflow(box: Element) {
	const list = box.querySelector<HTMLElement>(".tagList");
	const btn = box.querySelector<HTMLButtonElement>(".tagToggle");
	if (!list || !btn || box.classList.contains("open")) return;
	box.classList.add("close");
	const isOverflow = list.scrollHeight > list.clientHeight + 1;
	box.classList.toggle("close", isOverflow);
	btn.hidden = !isOverflow;
}

function bindTagToggle() {
	const box = document.querySelector(".footerArea .tagBox");
	if (!box) return;
	const btn = box.querySelector<HTMLButtonElement>(".tagToggle");
	const list = box.querySelector(".tagList");

	btn?.addEventListener("click", () => {
		const isOpen = box.classList.contains("close");
		box.classList.toggle("open", isOpen);
		setTagOpen(box, isOpen);
	});

	// 用鍵盤 Tab 到被收起來的標籤時自動展開，焦點才不會落在看不到的地方
	list?.addEventListener("focusin", () => {
		if (!box.classList.contains("close")) return;
		box.classList.add("open");
		setTagOpen(box, true);
	});

	checkTagOverflow(box);
	let timer = 0;
	window.addEventListener("resize", () => {
		clearTimeout(timer);
		timer = window.setTimeout(() => checkTagOverflow(box), 150);
	});
}

updateRunningDays();
bindCategoryToggle();
bindTagToggle();
onPageLoad(syncCurrentCategory);
</script>

<style lang="scss">
@use '../styles/setting' as *;

.footerArea {
	position: relative;
	margin-top: 6.25rem;
	padding: 4rem 0 1.25rem;

	@include media($breakpointSmall) {
		margin-top: 4rem;
		padding-top: 2.5rem;
	}

	@include pseudoBefore {
		@include pseudoShape(100%, 8px, $grayColor);
		top: 0;
		left: 0;
	}

	.copyright {
		@include font($ls: .08em, $lh: 1.5, $color: var(--text-faint));
		text-align: center;
		margin-top: 4rem;

		@include media($breakpointSmall) {
			font-size: $textSizeSmall;
			margin-top: 2.5rem;
		}

		a {
			text-decoration: underline;
			@extend %ts;

			@include hover {
				color: $mainColor;
			}
		}
	}
}

.otherBox {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	align-items: start;
	gap: 1.5rem;

	@include media($breakpointMedium) {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@include media($breakpointSmall) {
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}

	.Img {
		position: relative;
		align-self: center;
		justify-self: center;
		width: 100%;
		max-width: 300px;

		@include media($breakpointMedium) {
			display: none;
		}

		img {
			width: 100%;
			height: auto;
		}
	}
}

.otherItem {
	@include flex();
	flex-direction: column;
	gap: 1rem;
	min-width: 0;
	@include font($ls: .08em, $lh: 1.8);

	.titleBox {
		@include flex(nowrap, center, center);
		gap: .625rem;
		background-color: $grayColor;
		padding: 1rem .625rem;

		@include pseudoBefore($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
		}

		@include pseudoAfter($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
		}

		.title {
			@include textTrim();
		}
	}
}

.categoryList {
	@include flex();
	flex-direction: column;
	gap: 1.5rem;
	padding: 0 .625rem;

	.name {
		@include flex(nowrap, space-between, center);
		gap: .625rem;
	}

	a {
		@include flex(nowrap, flex-start, center);
		gap: .5625rem;
		@extend %ts;

		@include hover {
			color: $mainColor;
		}

		span {
			@include textTrim();
		}
	}

	.count {
		font-size: $textSizeSmall;
		color: $introColor;
	}

	.current {
		> .name {
			a {
				color: $mainColor;
			}
		}

		> a {
			color: $mainColor;
		}
	}

	.toggle {
		position: relative;
		flex-shrink: 0;
		width: 20px;
		height: 20px;

		// 橫線＋直線組成「+」，展開時直線轉平疊在橫線上變成「−」
		@include pseudoBefore {
			@include pseudoShape(10px, 1.5px, $mainColor);
			top: calc(50% - .75px);
			left: 5px;
			border-radius: 1px;
		}

		@include pseudoAfter {
			@include pseudoShape(10px, 1.5px, $mainColor);
			top: calc(50% - .75px);
			left: 5px;
			border-radius: 1px;
			@extend %ts;
		}
	}

	.subList {
		@include flex();
		flex-direction: column;
		gap: 1rem;
		padding-left: 1rem;
		margin-top: 1rem;
	}

	.close {
		.toggle::after {
			rotate: 90deg;
		}

		.subList {
			display: none;
		}
	}
}

.tagBox {
	@include flex();
	flex-direction: column;
	gap: .75rem;

	// 收合時只顯示三排：標籤高 2.125rem（行高 1.5rem + 上下 padding + 邊框）× 3 ＋ 兩個間距
	&.close {
		.tagList {
			max-height: 7.625rem;
			overflow: hidden;
			mask-image: linear-gradient(to bottom, #000 55%, transparent);
		}
	}
}

.tagToggle {
	@include flex(nowrap, center, center);
	gap: .5rem;
	align-self: center;
	font-size: $textSizeSmall;
	letter-spacing: .08em;
	color: $introColor;
	padding: .25rem .625rem;
	@extend %ts;

	@include hover {
		color: $mainColor;
	}

	&[hidden] {
		display: none;
	}

	// 向下的箭頭，展開後轉成向上
	@include pseudoAfter($position: relative) {
		@include pseudoShape(.4375rem, .4375rem);
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		translate: 0 -.125rem;
		rotate: 45deg;
		@extend %ts;
	}

	&[aria-expanded="true"]::after {
		translate: 0 .125rem;
		rotate: 225deg;
	}
}

.tagList {
	position: relative;
	@include flex(wrap);
	gap: .625rem;
	padding: 0 .625rem;

	a {
		// 每一排的標籤平均分配剩餘寬度，左右兩側都貼齊
		flex-grow: 1;
		min-width: 3.75rem;
		line-height: 1.5;
		text-align: center;
		background-color: $grayColor;
		border: 1px solid $borderColor;
		border-radius: 10px;
		padding: .25rem 1rem;
		@extend %ts;

		@include hover {
			color: $mainColor;
			border-color: $mainColor;
		}
	}
}

.statList {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: .8125rem 1.5rem;
	font-size: $textSizeSmall;
	padding: 0 .625rem;

	.statItem {
		@include flex(nowrap, space-between, center);
		gap: .625rem;
		white-space: nowrap;

		&.full {
			grid-column: 1 / -1;
		}
	}

	dt {
		line-height: 1.5;
	}

	dd {
		color: $introColor;
		@include textTrim();
	}
}
</style>
