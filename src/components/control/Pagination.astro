---
import iconPrev from "@assets/images/theme/icon-angle-double-left.svg?url";
import iconNext from "@assets/images/theme/icon-angle-double-right.svg?url";
import type { Page } from "astro";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<nav class:list={[className, "pageBox"]} style={style} aria-label="Pagination">
    {page.url.prev
        ? <a href={page.url.prev} class="arrow" aria-label="Previous Page"><img src={iconPrev} alt="" width="16" height="16" /></a>
        : <span class="arrow disabled"><img src={iconPrev} alt="" width="16" height="16" /></span>}
    {pages.map((p) => {
        if (p === HIDDEN) return <span class="num">…</span>;
        if (p === page.currentPage) return <span class="num current" aria-current="page">{p}</span>;
        return <a href={url(getPageUrl(p))} class="num" aria-label={`Page ${p}`}>{p}</a>;
    })}
    {page.url.next
        ? <a href={page.url.next} class="arrow" aria-label="Next Page"><img src={iconNext} alt="" width="16" height="16" /></a>
        : <span class="arrow disabled"><img src={iconNext} alt="" width="16" height="16" /></span>}
</nav>

<style lang="scss">
@import '../../styles/setting';

.pageBox {
	@include flex(nowrap, center, center);
	gap: 20px;
	margin-top: 42px;

	.num {
		@include font($fs: 20px, $ls: .08em, $lh: 1.5, $color: var(--text-muted));
		@extend %ts;

		&.current {
			color: $textColor;
		}
	}

	a {
		@include hover {
			color: $mainColor;
		}
	}

	.arrow {
		@include flex(nowrap, center, center);
		width: 16px;
		height: 16px;
		@extend %ts;

		&.disabled {
			opacity: .4;
		}

		img {
			display: block;
			width: 16px;
			height: 16px;
		}
	}

	a.arrow {
		@include hover {
			translate: 0 -2px;
		}
	}
}
</style>
