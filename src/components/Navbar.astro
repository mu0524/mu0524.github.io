---
import { Image } from "astro:assets";
import iconAbout from "@assets/images/theme/icon-about.svg?url";
import iconGithub from "@assets/images/theme/icon-github.svg?url";
import iconHome from "@assets/images/theme/icon-home.svg?url";
import infoBunny from "@assets/images/theme/info-bunny.png";
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { getLinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LanguageSwitch from "./LanguageSwitch.svelte";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";

interface Props {
	class?: string;
	lang?: string;
}

const { class: className, lang } = Astro.props;

const presets = getLinkPresets(lang);

// 設計稿有圖示素材的連結用素材，彙整沒有素材，改用同風格的實心圖示
const presetIcons: Partial<
	Record<LinkPreset, { src?: string; name?: string }>
> = {
	[LinkPreset.Home]: { src: iconHome },
	[LinkPreset.About]: { src: iconAbout },
	[LinkPreset.Archive]: { name: "material-symbols:inventory-2-rounded" },
};

type InfoLink = NavBarLink & { icon?: { src?: string; name?: string } };

const links: InfoLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): InfoLink => {
		if (typeof item === "number") {
			return { ...presets[item], icon: presetIcons[item] };
		}
		const isGithub = item.url.includes("github.com");
		return { ...item, icon: isGithub ? { src: iconGithub } : undefined };
	},
);
---
<header id="navbar" class:list={[className, "infoArea onload-animation"]}>
    <div class="textBox">
        <a href={url('/', lang)} class="title">{siteConfig.title}</a>
        {profileConfig.bio && <p class="text">{profileConfig.bio}</p>}
        <nav class="btnBox" aria-label="Main">
            {links.map((l) => (
                <a href={l.external ? l.url : url(l.url, lang)}
                   target={l.external ? "_blank" : null}
                   rel={l.external ? "noopener" : null}
                   class="btn">
                    {l.icon?.src && <img src={l.icon.src} alt="" width="24" height="24" />}
                    {l.icon?.name && <Icon name={l.icon.name} />}
                    <span>{l.name}</span>
                </a>
            ))}
            <div class="toolBox">
                <Search client:only="svelte" lang={lang}></Search>
                {!import.meta.env.PROD && (
                    <button aria-label="Display Settings" class="btn" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" />
                    </button>
                )}
                {siteConfig.supportedLangs && siteConfig.supportedLangs.length > 0 && (
                    <LanguageSwitch client:only="svelte" />
                )}
                <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            </div>
        </nav>
    </div>
    <div class="Img" aria-hidden="true">
        <Image src={infoBunny} alt="" width={400} height={400} loading="eager" />
    </div>
    {!import.meta.env.PROD && (
        <DisplaySettings client:only="svelte" />
    )}
</header>

<style lang="scss">
@import '../styles/setting';

.infoArea {
	position: relative;
	z-index: 40;
	@include flex($ai: center);
	gap: 24px;
	background-color: $grayColor;
	padding: 16px;

	@include media($breakpointSmall) {
		gap: 12px;
	}

	.textBox {
		@include flex();
		flex-direction: column;
		flex: 1 1 0;
		gap: 16px;
		min-width: 0;
	}

	.title {
		align-self: flex-start;
		@include font($fs: 32px, $fw: $fwBold, $ls: .05em, $lh: 1.5);

		@include media($breakpointSmall) {
			font-size: 26px;
		}
	}

	.text {
		@include font($ls: .05em, $lh: 1.5);
	}

	.btnBox,
	.toolBox {
		@include flex(wrap);
		gap: 16px;

		@include media($breakpointSmall) {
			gap: 10px;
		}
	}

	.toolBox {
		@include media(-769) {
			position: relative;
		}

		.btn,
		:global(#search-switch),
		:global(#scheme-switch) {
			width: 40px;
			padding: 0;
		}
	}

	.btn,
	:global(#search-switch),
	:global(#scheme-switch) {
		@include flex(nowrap, center, center);
		gap: 10px;
		height: 40px;
		@include font($ls: .1em, $lh: 1, $color: $introColor);
		white-space: nowrap;
		background-color: $btnBgColor;
		border-radius: 8px;
		padding: 0 10px;
		@extend %ts;

		@include hover {
			color: $textColor;
			background-color: $borderColor;
		}

		img,
		:global(svg) {
			flex-shrink: 0;
			width: 24px;
			height: 24px;
			color: $mainColor;
		}

		span {
			@include textTrim();
		}
	}

	:global(#search-panel) {
		z-index: 10;

		@include media(-769) {
			top: calc(100% + 8px);
			left: 0;
			right: auto;
		}
	}

	.Img {
		position: relative;
		flex-shrink: 0;
		width: 140px;
		height: 140px;
		overflow: clip;
		scale: -1 1;

		@include media($breakpointSmall) {
			width: 100px;
			height: 100px;
		}
		@include media($breakpointXS) {
			@include positionALTRB($t: 8px, $r: 8px);
			width: 72px;
			height: 72px;
		}

		:global(img) {
			@include positionALTRB($t: -22.04%, $l: -22.47%);
			width: 144.08%;
			max-width: none;
			height: 144.08%;
		}
	}
}
</style>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
