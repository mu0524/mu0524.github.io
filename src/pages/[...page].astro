---
import Pagination from "@components/Pagination.astro";
import PostCard from "@components/PostCard.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getPosts } from "@lib/posts";
import type { GetStaticPaths } from "astro";
import { SITE } from "@/site.config";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPosts();
	return paginate(posts, { pageSize: SITE.pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<PageLayout title={page.currentPage > 1 ? `第 ${page.currentPage} 頁` : undefined}>
	<div class="postList">
		{page.data.map((post, i) => (
			<PostCard post={post} class="onloadAnimation" style={`animation-delay: ${i * 50}ms`} />
		))}
	</div>
	{/* 只有一頁時不顯示頁碼 */}
	{page.lastPage > 1 && <Pagination current={page.currentPage} last={page.lastPage} />}
</PageLayout>

<style lang="scss">
@use '../styles/setting' as *;

.postList {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 64px 24px;

	@include media($breakpointMedium) {
		gap: 56px 20px;
	}
	@include media(991) {
		grid-template-columns: minmax(0, 1fr);
		gap: 48px;
	}
}
</style>
