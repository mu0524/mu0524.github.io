---
import { render } from "astro:content";
import path from "node:path";
import iconPrev from "@assets/images/theme/icon-angle-double-left.svg?url";
import iconNext from "@assets/images/theme/icon-angle-double-right.svg?url";
import Comment from "@components/comment/index.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import { DEFAULT_LANG, SUPPORTED_LANG } from "@constants/constants";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getCategoryUrl, getPostUrlBySlug, getTagUrl } from "@utils/url-utils";
import type { GetStaticPaths } from "astro";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import { licenseConfig, profileConfig, siteConfig } from "../../../config";
import {
	formatDateToYYYYMMDD,
	formatDateToYYYYMMMD,
} from "../../../utils/date-utils";

// export async function getStaticPaths() {
// 	const blogEntries = await getSortedPosts();
// 	return blogEntries.map((entry) => ({
// 		params: { slug: entry.id, id: entry.id },
// 		props: { entry },
// 	}));
// }

export const getStaticPaths = (async () => {
	const paths = [];

	for (const lang of SUPPORTED_LANG) {
		const postsForLang = await getSortedPosts(lang);

		const langParam = lang === DEFAULT_LANG ? undefined : lang;

		for (const entry of postsForLang) {
			paths.push({
				params: {
					lang: langParam,
					slug: entry.id,
				},
				props: { entry, lang },
			});
		}
	}

	return paths;
}) satisfies GetStaticPaths;

const { entry, lang } = Astro.props;
const { Content, headings } = await render(entry);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: import.meta.env.SITE,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};

const ogImage = entry.data.ogImage ?? entry.data.image;

const { category, subcategory, tags, published, updated } = entry.data;
const isUpdated = !!updated && updated.getTime() !== published.getTime();
---

<MainGridLayout banner={ogImage} title={entry.data.title} description={entry.data.description} lang={lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <article id="post-container" class="postArea">
        <div class="metaBox onload-animation">
            <span class="tag">{formatDateToYYYYMMMD(published)}</span>
            {isUpdated && updated && (
                <span class="tag">{i18n(I18nKey.updatedAt, lang)} {formatDateToYYYYMMMD(updated)}</span>
            )}
            {category && (
                <a href={getCategoryUrl(category, lang)} class="tag">
                    {category}{subcategory && ` / ${subcategory}`}
                </a>
            )}
        </div>

        <div class="titleBox onload-animation">
            <h1 class="title" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">
                {entry.data.title}
            </h1>
        </div>

        {tags.length > 0 && (
            <div class="tagBox onload-animation">
                {tags.map((tag) => (
                    <a href={getTagUrl(tag, lang)}># {tag}</a>
                ))}
            </div>
        )}

        {entry.data.image && (
            <figure class="Img onload-animation">
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", entry.id)} alt={entry.data.title} class="w-full h-full" />
            </figure>
        )}

        <Markdown class="markdown-content onload-animation">
            <Content />
        </Markdown>

        {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} updateDate={entry.data.updated} lang={lang} class="license-container onload-animation"></License>}
    </article>

    <Comment post={entry} lang={lang}></Comment>

    <nav class="pageNavBox" aria-label="Post navigation">
        {entry.data.nextSlug ? (
            <a href={getPostUrlBySlug(entry.data.nextSlug, lang)} class="btn prev">
                <img src={iconPrev} alt="" width="16" height="16" />
                <span>{entry.data.nextTitle}</span>
            </a>
        ) : <span></span>}
        {entry.data.prevSlug ? (
            <a href={getPostUrlBySlug(entry.data.prevSlug, lang)} class="btn next">
                <span>{entry.data.prevTitle}</span>
                <img src={iconNext} alt="" width="16" height="16" />
            </a>
        ) : <span></span>}
    </nav>
</MainGridLayout>

<style lang="scss">
@import '../../../styles/setting';

.postArea {
	position: relative;
	@include flex();
	flex-direction: column;
	gap: 1.25em;
	@include font($ls: .08em, $lh: 1.8);
	background-color: $grayColor;
	padding: 3em 3em 2em;

	@include media($breakpointMedium) {
		padding: 2.75em 2em 1.5em;
	}
	@include media($breakpointSmall) {
		font-size: $textSizeSmall;
		padding: 2.5em 1.25em 1.25em;
	}

	.Img {
		overflow: clip;
	}

	:global(.markdown-content) {
		margin-top: .75em;
	}

	:global(code),
	:global(pre) {
		letter-spacing: normal;
	}
}

.metaBox {
	@include positionALTRB($t: -1.25em, $l: 3em);
	z-index: 2;
	@include flex(wrap);
	gap: 1em;
	max-width: calc(100% - 6em);

	@include media($breakpointMedium) {
		left: 2em;
	}
	@include media($breakpointSmall) {
		left: 1.25em;
		max-width: calc(100% - 2.5em);
	}

	.tag {
		white-space: nowrap;
		color: $textColor;
		background-color: var(--surface-tag);
		padding: .375em 1em;
		@extend %ts;
	}

	a {
		@include hover {
			color: $mainColor;
		}
	}
}

.titleBox {
	@include flex(nowrap, center, center);
	gap: .625em;
	border-bottom: 2px dashed $borderColor;
	padding-bottom: .625em;

	@include pseudoBefore($position: relative) {
		@include pseudoShape(10px, 3px, $borderColor);
		flex-shrink: 0;
	}

	@include pseudoAfter($position: relative) {
		@include pseudoShape(10px, 3px, $borderColor);
		flex-shrink: 0;
	}

	.title {
		flex: 1 1 0;
		min-width: 0;
		font-size: 1.75em;
		font-weight: $fwRegular;
		line-height: 1.5;
		color: $textColor;
		text-align: center;

		@include media($breakpointSmall) {
			font-size: 1.5em;
		}
	}
}

.tagBox {
	@include flex(wrap, flex-end);
	gap: .625em;

	a {
		color: $mainColor;
		@include textTrim();
		@extend %ts;

		@include hover {
			color: $textColor;
		}
	}
}

.pageNavBox {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 24px;
	margin-top: 24px;

	@include media($breakpointSmall) {
		grid-template-columns: minmax(0, 1fr);
		gap: 12px;
	}

	.btn {
		@include flex(nowrap, flex-start, center);
		gap: 12px;
		min-width: 0;
		height: 56px;
		@include font($ls: .08em, $lh: 1.5);
		background-color: $grayColor;
		padding: 0 20px;
		@extend %ts;

		@include hover {
			color: $mainColor;
			background-color: $borderColor;
		}

		&.next {
			grid-column: 2 / 3;
			justify-content: flex-end;

			@include media($breakpointSmall) {
				grid-column: auto;
			}
		}

		span {
			@include oneLine;
		}

		img {
			flex-shrink: 0;
			width: 16px;
			height: 16px;
		}
	}
}
</style>
