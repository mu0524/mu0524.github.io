---
import { getEntry, render } from "astro:content";
import Markdown from "@components/Markdown.astro";
import PageLayout from "@layouts/PageLayout.astro";

const entry = await getEntry("pages", "about");
if (!entry) throw new Error("找不到 src/content/pages/about.md");

const { Content } = await render(entry);
const title = entry.data.title ?? "關於我";
---

<PageLayout title={title}>
	<article class="pageArea">
		<div class="titleBox">
			<h1 class="title">{title}</h1>
		</div>
		<Markdown class="aboutContent">
			<Content />
		</Markdown>
	</article>
</PageLayout>

<style lang="scss">
@use '../styles/setting' as *;

.pageArea {
	@include flex();
	flex-direction: column;
	gap: 2em;
	@include font($ls: .08em, $lh: 1.8);
	background-color: $grayColor;
	padding: 3em 3em 2.5em;

	@include media($breakpointMedium) {
		padding: 2.75em 2em 2em;
	}
	@include media($breakpointSmall) {
		font-size: $textSizeSmall;
		padding: 2em 1.25em 1.5em;
	}

	.titleBox {
		@include flex(nowrap, center, center);
		gap: .625em;
		border-bottom: 2px dashed $borderColor;
		padding-bottom: .625em;

		@include pseudoBefore($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
			flex-shrink: 0;
		}

		@include pseudoAfter($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
			flex-shrink: 0;
		}

		.title {
			flex: 1 1 0;
			font-size: 1.75em;
			line-height: 1.5;
			text-align: center;

			@include media($breakpointSmall) {
				font-size: 1.5em;
			}
		}
	}
}
</style>

<!-- about.md 的內文由 Markdown 產生，沒有 scope 屬性，樣式要寫成 global -->
<style lang="scss" is:global>
@use '../styles/setting' as *;

.aboutContent {
	.heroImg {
		width: min(100%, 26rem);

		img {
			width: 100%;
			height: auto;
			cursor: default;
		}
	}

	.aboutBox {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 17.5rem;
		grid-template-areas: "txt img";
		align-items: start;
		gap: 2.5em;

		@include media($breakpointSmall) {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"img"
				"txt";
			gap: 1.5em;
		}

		&.reverse {
			grid-template-columns: 17.5rem minmax(0, 1fr);
			grid-template-areas: "img txt";
			align-items: center;
			gap: 2em;

			@include media($breakpointSmall) {
				grid-template-columns: minmax(0, 1fr);
				grid-template-areas:
					"img"
					"txt";
				gap: 1.5em;
			}
		}

		.Txt {
			grid-area: txt;

			> * {
				& + * {
					margin-top: 1.25em;
				}
			}
		}

		.Img {
			grid-area: img;

			@include media($breakpointSmall) {
				justify-self: center;
				width: min(100%, 20rem);
			}

			img {
				width: 100%;
				height: auto;
				cursor: default;
			}
		}
	}

	.Txt {
		&.bubble {
			position: relative;
			justify-self: start;
			background-color: $btnBgColor;
			border: 1px solid $borderColor;
			border-radius: 1.5em;
			padding: 1.25em 1.75em;

			@include pseudoBefore() {
				@include pseudoShape(1rem, 1rem, $btnBgColor);
				@include positionALTRB($t: 50%, $l: -.5rem);
				border-bottom: 1px solid $borderColor;
				border-left: 1px solid $borderColor;
				transform: translateY(-50%) rotate(45deg);

				@include media($breakpointSmall) {
					inset: -.5rem auto auto 50%;
					transform: translateX(-50%) rotate(135deg);
				}
			}

			> * {
				& + * {
					margin-top: .5em;
				}
			}

			p {
				&:last-child {
					font-size: 1.125em;
					font-weight: $fwBold;
				}
			}

			code {
				color: var(--page-bg);
				background-color: $mainColor;
			}
		}
	}

	.storyBox {
		background-color: $btnBgColor;
		border-left: 4px solid $mainColor;
		border-radius: 0 1em 1em 0;
		padding: 1.25em 1.5em;

		> * {
			& + * {
				margin-top: .75em;
			}
		}
	}

	.cardList {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 1em;

		&.topic {
			grid-template-columns: repeat(2, minmax(0, 1fr));

			@include media($breakpointXS) {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	}

	.cardItem {
		background-color: $btnBgColor;
		border: 1px solid $borderColor;
		border-radius: 1em;
		padding: 1.25em;

		.title {
			font-weight: $fwBold;
			line-height: 1.5;
			margin-bottom: .75em;
		}

		.text {
			font-size: .9375em;
			line-height: 1.8;
			color: $introColor;
		}

		.tagBox {
			@include flex(wrap);
			gap: .5em;

			span {
				font-size: .875em;
				line-height: 1;
				background-color: var(--surface-tag);
				border-radius: 999px;
				padding: .5em .875em;
			}
		}
	}
}
</style>
