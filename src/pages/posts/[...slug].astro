---
import { render } from "astro:content";
import License from "@components/License.astro";
import Markdown from "@components/Markdown.astro";
import PostNav from "@components/PostNav.astro";
import Toc from "@components/Toc.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { formatDate, formatIsoDate } from "@lib/date";
import { getAdjacentPosts, getPosts, type Post } from "@lib/posts";
import { categoryUrl, postUrl, subcategoryUrl, tagUrl } from "@lib/url";
import type { GetStaticPaths } from "astro";
import { SITE } from "@/site.config";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, ...getAdjacentPosts(posts, post.id) },
	}));
}) satisfies GetStaticPaths;

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const {
	title,
	description,
	published,
	updated,
	tags,
	category,
	subcategory,
	image,
} = post.data;
const isUpdated = !!updated && updated.getTime() !== published.getTime();
const url = new URL(postUrl(post.id), Astro.site).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description: description || title,
	keywords: tags,
	author: { "@type": "Person", name: SITE.author, url: SITE.url },
	datePublished: formatIsoDate(published),
	...(isUpdated && updated ? { dateModified: formatIsoDate(updated) } : {}),
	inLanguage: SITE.lang,
	url,
};
---

<PageLayout title={title} description={description} image={image} article={{ published, updated, tags }}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<article id="post-container" class="postArea" data-category={category} data-subcategory={subcategory} data-pagefind-body>
		<div class="metaBox">
			<span class="tag">{formatDate(published)}</span>
			{isUpdated && updated && <span class="tag">更新於 {formatDate(updated)}</span>}
			{category && (
				<a href={subcategory ? subcategoryUrl(category, subcategory) : categoryUrl(category)} class="tag">
					{category}{subcategory && ` / ${subcategory}`}
				</a>
			)}
		</div>

		<div class="titleBox">
			<h1 class="title" data-pagefind-meta="title">{title}</h1>
		</div>

		{tags.length > 0 && (
			<div class="tagBox">
				{tags.map((tag) => (
					<a href={tagUrl(tag)}># {tag}</a>
				))}
			</div>
		)}

		<Markdown>
			<Content />
		</Markdown>

		<License title={title} url={url} published={published} updated={updated} />
	</article>

	<PostNav
		newer={newer && { title: newer.data.title, url: postUrl(newer.id) }}
		older={older && { title: older.data.title, url: postUrl(older.id) }}
	/>

	<Toc slot="aside" headings={headings} />
</PageLayout>

<style lang="scss">
@use '../../styles/setting' as *;

.postArea {
	position: relative;
	@include flex();
	flex-direction: column;
	gap: 1.25em;
	@include font($ls: .08em, $lh: 1.8);
	background-color: $grayColor;
	padding: 3em 2em 2em;

	@include media($breakpointMedium) {
		padding: 2.75em 2em 1.5em;
	}
	@include media($breakpointSmall) {
		font-size: $textSizeSmall;
		padding: 2.5em 1.25em 1.25em;
	}

	// 內文第一個元素（通常是 h2）不留上方間距，與標籤列的距離只由 gap 決定
	:global(.markdownBox > :first-child) {
		margin-top: 0;
	}
}

.metaBox {
	@include positionALTRB($t: -1em, $l: 2em);
	z-index: 2;
	@include flex(wrap);
	gap: 1em;
	max-width: calc(100% - 6em);

	@include media($breakpointMedium) {
		left: 2em;
	}
	@include media($breakpointSmall) {
		left: 1.25em;
		max-width: calc(100% - 2.5em);
	}

	.tag {
		font-size: .85rem;
		line-height: 1;
		white-space: nowrap;
		color: $textColor;
		background-color: var(--surface-tag);
		padding: .625em 1em;
		@extend %ts;
	}

	a {
		@include hover {
			color: $mainColor;
		}
	}
}

.titleBox {
	border-bottom: 2px dashed $borderColor;
	padding-bottom: .625em;

	.title {
		position: relative;
		@include flex(nowrap, flex-start, center);
		gap: .625em;
		font-size: 1.5em;
		font-weight: $fwMedium;
		line-height: 1.5;
		color: $textColor;

		@include pseudoBefore($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
			flex-shrink: 0;
		}

		@include pseudoAfter($position: relative) {
			@include pseudoShape(10px, 3px, $borderColor);
			flex-shrink: 0;
		}
	}
}

.tagBox {
	@include flex(wrap, flex-end);
	gap: .625em;

	a {
		color: $mainColor;
		@include textTrim();
		@extend %ts;

		@include hover {
			color: $textColor;
		}
	}
}

</style>
